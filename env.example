# Copy this file to ".env" (same folder) and fill in your real values.
# NEVER upload the real .env anywhere public or share it with anyone.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free key from https://pixabay.com/api/docs/ (used to find real photos for blog/project images)
PIXABAY_API_KEY=

# Your admin panel's gateway (Step 2 file)
ADMIN_API_URL=https://admin.smartedgetech.in/agent-api.php

# MUST match AGENT_API_KEY that you put in admin's own .env file (Step 1)
ADMIN_AGENT_KEY=

# One line describing your business, used by the agents to stay on-topic
BUSINESS_CONTEXT=SmartEdge Technologies - a software & IT services company in India offering web development, custom software, and digital solutions for businesses
